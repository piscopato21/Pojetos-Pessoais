#biblioteca
from time import sleep

#inputs iniciais e variaveis
n1 = 0
print('====MENU====')
print('[1] Somar \n' '[2] multiplicar \n' '[3] maior valor \n' '[4] novos números \n' '[5] Sair do programa')
n2 = int(input('Digite o primeiro valor: '))
n3 = int(input('Digite o segundo valor: '))

#contas e loop sendo feito
while n1 != 5:
    n1 = int(input('Digite uma opção do menu: '))
    print('=========================')
    if n1 == 1:
        n4 = n2 + n3
        print('CALCULANDO. AGUARDE...')
        sleep(2)
        print(f'{n2} + {n3} = {n4} ')
        print('=========================')
    if n1 == 2:
        n4 = n2 * n3
        print('CALCULANDO. AGUARDE...')
        sleep(2)
        print(f'{n2} X {n3} = {n4} ')
        print('=========================')
    if n1 == 3:
        if n2 > n3:
            print(f'O maior valor é {n2}.')
        else:
            print(f'O maior valor é {n3}.')
        print('=========================')
    if n1 == 4:
        n2 = int(input('Digite o primeiro valor: '))
        n3 = int(input('Digite o segundo valor: '))
        print('=========================')
    if n1 == 5:
        print('Adeus.')
    else:
        print("ERRO! TENTE NOVAMENTE.")
