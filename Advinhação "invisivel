print('====ADVINHAÇÃO====')

from random import randint
cont = 1
numU = int(input('Digite um número de 1 a 10: '))
num = randint(0, 10)
while numU != num:
    cont += 1
    if numU != num:
        print('Errou o numero que eu pensei.')
        numU = int(input('Digite novamente: '))
print(f'Você acertou depois de {cont} tenteativa(s).')
print('====FIM DE JOGO====')
